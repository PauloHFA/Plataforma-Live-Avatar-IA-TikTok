# TikTok Live Source
TIKTOK_UNIQUE_ID=@seu_usuario
LIVE_SOURCE_MODE=simulator

# LLM (OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=[REDACTED]
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
LLM_TIMEOUT_SECONDS=6.0

# Moderation (optional external moderation endpoint; rule + heuristic layers always active)
MODERATION_ENABLED=true
MODERATION_API_URL=
MODERATION_API_KEY=[REDACTED]

# TTS
TTS_PROVIDER=mock
TTS_VOICE=pt-BR-FranciscaNeural
TTS_API_KEY=[REDACTED]
TTS_REGION=brazilsouth
TTS_TIMEOUT_SECONDS=4.0
TTS_CACHE_DIR=./audio_cache

# Budget & Security
DAILY_BUDGET_USD=5.0
OPERATOR_TOKEN=[REDACTED]
SQLITE_PATH=./data/live_audit.db
RETENTION_DAYS=30

# Servers & OBS
API_HOST=127.0.0.1
API_PORT=8080
WS_HOST=127.0.0.1
WS_PORT=8765
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=[REDACTED]
OBS_CONTINGENCY_SCENE=Contingencia
ALERT_WEBHOOK_URL=
